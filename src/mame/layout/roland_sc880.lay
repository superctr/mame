<mamelayout version="2">
	<element name="glass"><rect><color red="0.55" green="0.78" blue="0.42"/></rect></element>
	<element name="rule"><rect><color red="0.06" green="0.19" blue="0.09"/></rect></element>
	<element name="digit"><led7seg><color red="0.06" green="0.19" blue="0.09"/></led7seg></element>
	<element name="label_part"><text string="PART"><color red="0.06" green="0.19" blue="0.09"/></text></element>
	<element name="label_perf"><text string="PERF"><color red="0.06" green="0.19" blue="0.09"/></text></element>
	<element name="label_patch"><text string="PATCH"><color red="0.06" green="0.19" blue="0.09"/></text></element>
	<element name="label_tone"><text string="TONE"><color red="0.06" green="0.19" blue="0.09"/></text></element>
	<element name="label_rhy"><text string="RHY"><color red="0.06" green="0.19" blue="0.09"/></text></element>
	<element name="label_mfx"><text string="M-FX"><color red="0.06" green="0.19" blue="0.09"/></text></element>
	<element name="label_sys"><text string="SYS"><color red="0.06" green="0.19" blue="0.09"/></text></element>
	<element name="label_util"><text string="UTIL"><color red="0.06" green="0.19" blue="0.09"/></text></element>

	<view name="Display">
		<bounds x="0" y="0" width="140" height="50"/>
		<element ref="glass"><bounds x="0" y="0" width="140" height="50"/></element>
		<repeat count="25">
			<param name="n" start="0" increment="1"/>
			<param name="x" start="2.90" increment="5.44"/>
			<element name="digit~n~" ref="digit"><bounds x="~x~" y="1.5" width="3.6" height="9.5"/></element>
		</repeat>
		<element ref="label_part"><bounds x="2.00" y="1" width="10.88" height="3.5"/></element>
		<element ref="label_perf"><bounds x="29.20" y="1" width="16.32" height="3.5"/></element>
		<element ref="label_patch"><bounds x="45.52" y="1" width="16.32" height="3.5"/></element>
		<element ref="label_tone"><bounds x="61.84" y="1" width="16.32" height="3.5"/></element>
		<element ref="label_rhy"><bounds x="78.16" y="1" width="16.32" height="3.5"/></element>
		<element ref="label_mfx"><bounds x="94.48" y="1" width="16.32" height="3.5"/></element>
		<element ref="label_sys"><bounds x="110.80" y="1" width="16.32" height="3.5"/></element>
		<element ref="label_util"><bounds x="127.12" y="1" width="10.88" height="3.5"/></element>
		<element ref="rule"><bounds x="2" y="12.5" width="136" height="0.5"/></element>
		<screen index="0"><bounds x="2" y="15" width="136" height="32"/></screen>
	</view>
</mamelayout>
